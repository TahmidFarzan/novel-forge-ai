# Docker Compose configuration for novel-forge-ai.
# Copy this file to docker/.env to override the defaults baked into
# docker-compose.yml. Every value below is optional.
#
# Application settings (APP_ENV, APP_KEY, database, mail) live in src/.env.
# That file is created from src/.env.example on first boot and is never
# overwritten afterwards.

# --- HTTP entrypoint ------------------------------------------------------
NGINX_HTTP_PORT=80
APP_URL=http://novel-forge-ai.localhost/

# --- Application -> Ollama ------------------------------------------------
# Inside the stack the app resolves Ollama by service name. To reach an Ollama
# server running on the host instead, point these at
# http://host.docker.internal:11434.
AI_BRAIN_URL=http://ollama:11434
AI_BRAIN_API_KEY=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST=http://ollama:11434

# --- Ollama service -------------------------------------------------------
OLLAMA_VERSION=0.35.1
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_CONTEXT_LENGTH=8192
